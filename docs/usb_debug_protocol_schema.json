      {"offset": 1, "name": "trigger_type", "type": "u8", "values": {"NONE": 0, "MANUAL": 1, "FAULT": 2, "STATE": 3, "THRESHOLD": 4}},
      {"offset": 2, "name": "trigger_channel", "type": "u16", "none": 65535},
      {"offset": 4, "name": "trigger_edge", "type": "u8", "values": {"RISING": 0, "FALLING": 1}},
