      {"offset": 4, "name": "sample_count", "type": "u16"},
      {"offset": 6, "name": "channel_count", "type": "u8"},
      {"offset": 7, "name": "flags", "type": "u8"},
      {"offset": 8, "name": "dropped_samples", "type": "u16"},
      {"offset": 10, "name": "reserved", "type": "u16", "required": 0},
