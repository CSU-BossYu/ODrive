    "TEST_SESSION_END": {"length": 4, "fields": [{"offset": 0, "name": "session_id", "type": "u32"}], "semantics": "Accepted only after STOP completed for motion sessions; response is TEST_SESSION_STATUS INACTIVE"}
  }
