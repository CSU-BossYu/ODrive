{
  "protocol": "ODrive USB Debug/Test",
  "protocol_release": "4.5",
  "protocol_version": 4,
  "schema_version": 4,
  "byte_order": "little-endian",
  "magic_u16": "0x4F44",
  "header_size": 40,
  "max_payload": 512,
  "transport": {
    "kind": "USB CDC byte stream",
    "session_start": "CDC is binary-only; host sends HELLO and device emits no frames before accepting it",
    "legacy_text": "Forbidden on this CDC stream; diagnostics use LOG_RECORD, FAULT_EVENT and STATE_EVENT",
    "usb_packet_fragmentation": "A protocol frame may span any number of USB packets; packet boundaries have no protocol meaning. Firmware submissions are capped at 63 bytes to avoid the customized STM32 CDC full-packet ZLP completion path",
    "resynchronization": "Scan for magic, validate bounded payload_length and CRC, then resume scanning after malformed input"
  },
  "crc": {
    "name": "CRC-32/ISO-HDLC",
    "polynomial_normal": "0x04C11DB7",
    "polynomial_reflected": "0xEDB88320",
    "init": "0xFFFFFFFF",
    "refin": true,
    "refout": true,
    "xorout": "0xFFFFFFFF",
    "coverage": "header || payload",
    "wire_type": "u32"
  },
  "flags": {
    "FRAME_RESPONSE": 1,
    "FRAME_ERROR": 2,
    "FRAME_DROPPED": 4
  },
  "message_types": {
    "HELLO": 1,
    "CAPABILITIES": 2,
    "COMMAND": 3,
    "COMMAND_RESULT": 4,
    "FAULT_EVENT": 5,
    "STATE_EVENT": 6,
    "LOG_RECORD": 7,
    "SCOPE_RECORD": 8,
    "STATS": 9,
    "CALIBRATION_DATA": 10
    ,"SCOPE_CONFIG": 11
    ,"SCOPE_ARM": 12
    ,"SCOPE_STATUS": 13
    ,"SCOPE_DATA_BATCH": 14
    ,"SCOPE_STOP": 15
    ,"CRASH_REPORT": 16
    ,"CRASH_ACK": 17
    ,"TEST_SESSION_BEGIN": 18
    ,"TEST_SESSION_STATUS": 19
    ,"TEST_SESSION_KEEPALIVE": 20
    ,"TEST_SESSION_STOP": 21
    ,"TEST_SESSION_END": 22
  },
  "directions": {
    "host_to_device": ["HELLO", "COMMAND", "STATS", "SCOPE_CONFIG", "SCOPE_ARM", "SCOPE_STATUS", "SCOPE_STOP", "CRASH_ACK", "TEST_SESSION_BEGIN", "TEST_SESSION_KEEPALIVE", "TEST_SESSION_STOP", "TEST_SESSION_END"],
    "device_to_host": ["CAPABILITIES", "COMMAND_RESULT", "FAULT_EVENT", "STATE_EVENT", "LOG_RECORD", "SCOPE_RECORD", "STATS", "CALIBRATION_DATA", "SCOPE_STATUS", "SCOPE_DATA_BATCH", "CRASH_REPORT", "CRASH_ACK", "TEST_SESSION_STATUS"]
  },
  "command_type": {
    "SET_OPERATION": 1,
    "ARM": 2,
    "DISARM": 3,
    "CLEAR_FAULTS": 4,
    "RESET_ESTIMATOR": 5,
    "RESTART_CALIBRATION": 6
  },
  "operation": {
    "NONE": 0,
    "CLOSED_LOOP": 1,
    "CALIBRATION": 2,
    "SELF_TEST": 3
  },
  "command_status": {
    "ACCEPTED": 0,
    "REJECTED": 1,
    "COMPLETED": 2,
    "FAILED": 3
  },
  "request_semantics": {
    "request_id_zero": "invalid",
    "command_lifecycle": "Exactly one terminal REJECTED, COMPLETED, or FAILED result; accepted asynchronous commands first emit ACCEPTED",
    "duplicate_window": 16,
    "sequence_expiry_window": 128,
    "source_isolation": "Only CommandSource::USB results are correlated as USB COMMAND_RESULT responses"
  },
