      {"offset": 1, "name": "reserved", "type": "u8", "required": 0}
    ]},
    "SCOPE_STATUS": {"length": 32, "fields": [
      {"offset": 0, "name": "capture_id", "type": "u32"},
      {"offset": 4, "name": "state", "type": "u8"},
      {"offset": 5, "name": "final_reason", "type": "u8"},
      {"offset": 6, "name": "mode", "type": "u8"},
      {"offset": 7, "name": "trigger_type", "type": "u8"},
      {"offset": 8, "name": "sample_count", "type": "u32"},
      {"offset": 12, "name": "dropped_samples", "type": "u32"},
